# ── P0 / local CI ─────────────────────────────────────────────────────────
# MOCK_LLM=1  → 不调用外部 LLM，使用 src/engine/fixtures/mock_{kill,test,build}.json
# MOCK_LLM=0  → 真实 LLM（需 OPENAI_API_KEY 或 ANTHROPIC_API_KEY）；都没有则走启发式
MOCK_LLM=1

# 写入 ValidationReport.pipeline_version
PIPELINE_VERSION=p2.0.0

# ── P1a Supabase（可选；URL + SERVICE_ROLE 齐全时 API 自动用 Supabase）────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── P1b 真实 LLM（MOCK_LLM=0 时生效；优先 OpenAI）────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── P1c MCP（mcp/ 进程调用本 API）─────────────────────────────────────────
# IDEA4AI_API_BASE=http://localhost:3000

# ── P1 真实检索（npm + HN Algolia → L2 collision hints；默认关，CI 不打外网）─
# ENABLE_RETRIEVAL=1
# 注意：MOCK_LLM=1 走 fixture，不会发起检索；启发式/真实 LLM 路径才会拉取。

# ── P1 深度研究 LLM 增强（默认启发式；需 MOCK_LLM=0 + LLM key）────────────
# ENABLE_DEEP_RESEARCH=1
