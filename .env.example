# ── P0 (required for local / CI) ──────────────────────────────────────────
# MOCK_LLM=1  → 不调用外部 LLM，使用 src/engine/fixtures/mock_{kill,test,build}.json
# MOCK_LLM=0  → 走启发式流水线（仅演示，非生产）
MOCK_LLM=1

# 写入 ValidationReport.pipeline_version
PIPELINE_VERSION=p0.1.0

# ── P1+ (optional; leave commented until Supabase / real LLM is wired) ────
